DB_PATH=./sponsor.db
PORT=8787
# where the API listens. keep it on localhost when running behind a tunnel
HOST=127.0.0.1
PRIVY_APP_ID=
PRIVY_APP_SECRET=
ALLOWED_ORIGINS=https://demo.kamigotchi.io
# 1 behind cloudflared: client IPs come from the CF-Connecting-IP header the tunnel sets.
# only safe while HOST keeps the API off the public network. 0 when exposed directly
TRUST_PROXY=1
MAX_SPONSORED_PLAYERS=500
